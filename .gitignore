# =====================================================================
# Git Ignore — AI in Cyber Security Capstone Project
# =====================================================================

# Python Virtual Environments
.venv/
venv/
env/
ENV/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo
*~

# OS-generated files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Logs and outputs
*.log
logs/

# Model binaries (too large for Git)
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.onnx

# Environment files
.env
